# =============================================================================
# Verbis — local development environment
# -----------------------------------------------------------------------------
# `pnpm install` copies this file to `.env` if it does not exist (scripts/ensure-env.mjs).
# Values below are DEVELOPMENT-ONLY placeholders for services bound to 127.0.0.1.
# Never reuse them anywhere else. Real secrets never go into git (CLAUDE.md rule 3).
# Every service validates its env with zod at startup and refuses to start if invalid.
# =============================================================================

# --- General -----------------------------------------------------------------
# Runtime mode: development | test | production
NODE_ENV=development
# Log level for backend services: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# Version string reported by health endpoints
APP_VERSION=0.0.0-dev

# --- PostgreSQL 16 (system of record, ADR-0003) -------------------------------
# Superuser created by the postgres container on first start
POSTGRES_USER=verbis
# Dev-only password for the postgres container
POSTGRES_PASSWORD=verbis_dev_only_change_me
# Database created on first start
POSTGRES_DB=verbis
# Host port mapped to the container (127.0.0.1 only)
POSTGRES_PORT=5432
# Owner connection used ONLY by Prisma migrations and the seed (must match the values above)
DATABASE_URL=postgresql://verbis:verbis_dev_only_change_me@127.0.0.1:5432/verbis?schema=public
# Password for the least-privilege runtime role verbis_app (set by `pnpm db:migrate`)
DATABASE_APP_PASSWORD=verbis_app_dev_only_change_me
# Runtime connection of apps/api as verbis_app; Row-Level Security always applies to it
DATABASE_APP_URL=postgresql://verbis_app:verbis_app_dev_only_change_me@127.0.0.1:5432/verbis?schema=public
# Password for the audit worker role verbis_audit_worker (set by `pnpm db:migrate`)
DATABASE_AUDIT_WORKER_PASSWORD=verbis_audit_dev_only_change_me
# Connection of the audit worker process (never the owner; RLS applies)
AUDIT_WORKER_DATABASE_URL=postgresql://verbis_audit_worker:verbis_audit_dev_only_change_me@127.0.0.1:5432/verbis?schema=public

# --- Redis 7 (cache, sessions, one-time tokens, BullMQ) -----------------------
# Host port for Redis
REDIS_PORT=6379
# Dev-only password (requirepass)
REDIS_PASSWORD=redis_dev_only_change_me
# Connection URL used by services (must match REDIS_PASSWORD/REDIS_PORT)
REDIS_URL=redis://:redis_dev_only_change_me@127.0.0.1:6379/0

# --- NATS JetStream (event bus, ADR-0005) ------------------------------------
# Client port
NATS_PORT=4222
# HTTP monitoring port (/healthz, /varz, /jsz)
NATS_MONITOR_PORT=8222
# Client URL used by services
NATS_URL=nats://127.0.0.1:4222

# --- Keycloak (dev IdP; realm "verbis-dev" auto-imported) ---------------------
# Host port for Keycloak HTTP
KEYCLOAK_PORT=8080
# Bootstrap admin for the Keycloak master realm console (http://localhost:8080/admin)
KEYCLOAK_ADMIN_USERNAME=kc_admin
KEYCLOAK_ADMIN_PASSWORD=kc_admin_dev_only_change_me
# OIDC issuer of the dev realm (used by the BFF in roadmap step 7)
OIDC_ISSUER_URL=http://localhost:8080/realms/verbis-dev
# Confidential client for the BFF (imported into the realm)
OIDC_CLIENT_ID=verbis-bff
# Client secret for verbis-bff, injected into the realm import (dev only)
OIDC_CLIENT_SECRET=verbis_bff_dev_only_change_me
# Passwords of the three dev realm users: admin / designer / agent
DEV_USER_ADMIN_PASSWORD=admin_dev_only_change_me
DEV_USER_DESIGNER_PASSWORD=designer_dev_only_change_me
DEV_USER_AGENT_PASSWORD=agent_dev_only_change_me

# --- MinIO / S3 (assets, exports, audit WORM anchors) -------------------------
# Root credentials (dev only; MinIO requires >= 8 characters)
MINIO_ROOT_USER=verbis_minio
MINIO_ROOT_PASSWORD=minio_dev_only_change_me
# S3 API port and web console port
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# S3 endpoint and default bucket used by services
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=verbis-dev
# Region label for S3 clients
S3_REGION=us-east-1

# --- Mailpit (captures all outgoing mail in dev) ------------------------------
# SMTP port services send to
SMTP_PORT=1025
# Web UI to read captured mail (http://localhost:8025)
MAILPIT_UI_PORT=8025
# SMTP URL used by services
SMTP_URL=smtp://127.0.0.1:1025

# --- Observability ------------------------------------------------------------
# OTLP ports on the OpenTelemetry Collector (gRPC / HTTP)
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
# Where services send traces/metrics/logs
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# Prometheus UI/API port
PROMETHEUS_PORT=9090
# Alertmanager UI/API port
ALERTMANAGER_PORT=9093
# Grafana UI port and dev admin credentials
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=grafana_dev_only_change_me
# Jaeger UI port
JAEGER_UI_PORT=16686

# --- Applications -------------------------------------------------------------
# apps/api (NestJS) bind address and port
API_HOST=127.0.0.1
API_PORT=4000
# Public JWKS of internal-token issuers (the BFF). Generated locally by `pnpm install` when empty.
INTERNAL_JWT_JWKS=
# DEV ONLY: private key matching INTERNAL_JWT_JWKS, used by `pnpm --filter @verbis/api dev:token`.
# Generated locally when empty; never set it outside your machine.
INTERNAL_JWT_DEV_PRIVATE_JWK=
# Issuer and audience the API expects in internal tokens
INTERNAL_JWT_ISSUER=verbis-api-gateway
INTERNAL_JWT_AUDIENCE=verbis-api
# Comma-separated browser origins allowed for every tenant (tenants add their own in settings)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
# Requests per window per tenant+principal (or per IP when anonymous), stored in Redis
RATE_LIMIT_MAX=600
RATE_LIMIT_WINDOW_MS=60000
# OpenAPI docs at /api/docs: public (development only) | admin (read:ApiDocs) | off
API_DOCS=public
# Transactional outbox relay (outbox_events -> NATS JetStream)
OUTBOX_RELAY_ENABLED=true
OUTBOX_BATCH_SIZE=100
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_MAX_ATTEMPTS=10
# Domain-event consumers (e.g. analytics counters)
EVENT_CONSUMERS_ENABLED=true
# Script documents larger than this (bytes, canonical JSON) are stored gzip-compressed
SCRIPT_DOCUMENT_COMPRESSION_THRESHOLD_BYTES=262144
# Retention of Idempotency-Key records (hours)
IDEMPOTENCY_TTL_HOURS=24
# --- Identity (apps/api modules/identity, ADR-0012) ----------------------------
# AES-256-GCM keyring kid:base64(32 bytes)[,kid:key...]; first seals, all open. Generated locally when empty.
IDENTITY_ENCRYPTION_KEYS=
# Private JWK signing client-credentials tokens (kid must be in INTERNAL_JWT_JWKS). Dev: copied from the dev key.
INTERNAL_JWT_SIGNING_JWK=
# Public base URL of the API for protocol endpoints called directly (SCIM, OAuth token, SAML metadata, back-channel logout)
PUBLIC_API_URL=http://localhost:4000
# Browser apps that may start a login (app=origin); {tenant} in an origin resolves the tenant from the host
AUTH_APP_ORIGINS=admin=http://localhost:5175,designer=http://localhost:5173,agent=http://localhost:5174
# Path under which the web apps proxy the API
AUTH_PUBLIC_PATH_PREFIX=/api
# Session cookie (sent as __Host-<name> when Secure); SameSite lax|strict
SESSION_COOKIE_NAME=verbis_session
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_SECURE=true
# Session defaults (tenants override in settings.session)
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_TIMEOUT_HOURS=12
SESSION_MAX_CONCURRENT=5
# Refresh IdP tokens (rotation) when the access token expires; ends sessions the IdP has ended
OIDC_REFRESH_ON_EXPIRY=true
# Clock skew tolerated for id_token / logout_token / SAML assertions (seconds)
IDENTITY_CLOCK_SKEW_SECONDS=30
# DEV ONLY: IdP hosts reachable over http and allowed to resolve to private addresses (dev Keycloak)
IDENTITY_EGRESS_ALLOW_HTTP_HOSTS=localhost
IDENTITY_EGRESS_ALLOW_PRIVATE_HOSTS=localhost
# Break-glass local admin (password + TOTP, admin-web only)
BREAK_GLASS_ENABLED=true
BREAK_GLASS_ALLOWED_ORIGINS=http://localhost:5175
BREAK_GLASS_SESSION_MINUTES=60
BREAK_GLASS_IDLE_MINUTES=10
BREAK_GLASS_MAX_ATTEMPTS=5
BREAK_GLASS_LOCKOUT_MINUTES=15
# Client-credentials access-token lifetime (seconds, <= 300)
OAUTH_ACCESS_TOKEN_TTL_SECONDS=300
# Header with the client certificate (URL-encoded PEM) set by a trusted TLS proxy; empty = TLS socket only
MTLS_CLIENT_CERT_HEADER=
# apps/connector-hub (NestJS) bind address and port
CONNECTOR_HUB_HOST=127.0.0.1
CONNECTOR_HUB_PORT=4100
# Base URL of the API as seen from the hub (mTLS in production)
HUB_API_URL=http://127.0.0.1:4000
# Tenants the hub serves: JSON [{"slug":"acme","clientId":"<service client id>"}]
# Each tenant has an mTLS (tls_client_auth) service client with scopes read:Connector update:Connector create:Session
HUB_TENANTS=[]
# Client certificate/key/CA files (PEM); provisioned locally by pnpm dev:bootstrap
HUB_CLIENT_CERT_FILE=
HUB_CLIENT_KEY_FILE=
HUB_CA_FILE=
# Public JWKS the hub trusts for API → hub internal calls (the API's INTERNAL_JWT_SIGNING_JWK public part)
HUB_TRUSTED_JWKS={"keys":[]}
# Loopback-only dev mTLS edge (proxy to API_INTERNAL_URL). Bootstrap provisions its cert/key.
DEV_MTLS_PORT=4443
DEV_MTLS_CERT_FILE=
DEV_MTLS_KEY_FILE=
# Bounded event queue (backpressure) and parallel deliveries to the API
HUB_QUEUE_CAPACITY=1000
HUB_DELIVERY_CONCURRENCY=8
# Interaction Simulator connector (dev/demo only; refused in production)
SIMULATOR_ENABLED=true
# API side: where the hub listens (participant verification, simulator proxy)
CONNECTOR_HUB_URL=http://127.0.0.1:4100
# Vite dev/preview ports for the web apps
DESIGNER_WEB_PORT=5173
AGENT_WEB_PORT=5174
ADMIN_WEB_PORT=5175
# Base URL the web dev servers proxy /api/* to (server-side only, never exposed to the browser)
API_INTERNAL_URL=http://127.0.0.1:4000

# --- Audit (ADR-0014) ----------------------------------------------------------
# Private Ed25519 JWK signing audit checkpoints (worker only). Generated locally when empty.
AUDIT_CHECKPOINT_SIGNING_JWK=
# Public JWKS verifying checkpoints (API + worker; include retired keys). Generated with the key.
AUDIT_CHECKPOINT_JWKS=
# Seconds between checkpoint attempts per tenant
AUDIT_CHECKPOINT_INTERVAL_SECONDS=300
# Monthly partitions created ahead of time
AUDIT_PARTITION_MONTHS_AHEAD=3
# Default legal retention (days) when a tenant sets none; partitions are only dropped after a verified WORM archive
AUDIT_DEFAULT_RETENTION_DAYS=3650
# WORM archive (S3 Object Lock). Leave the endpoint empty to disable archiving and partition drops.
AUDIT_ARCHIVE_S3_ENDPOINT=
AUDIT_ARCHIVE_S3_REGION=us-east-1
AUDIT_ARCHIVE_S3_BUCKET=verbis-audit-archive
AUDIT_ARCHIVE_S3_ACCESS_KEY_ID=
AUDIT_ARCHIVE_S3_SECRET_ACCESS_KEY=
AUDIT_ARCHIVE_LOCK_MODE=COMPLIANCE
# SIEM delivery batch size and retry backoff cap
SIEM_BATCH_SIZE=200
SIEM_MAX_BACKOFF_SECONDS=300

# --- Authoring packages and routing (ADR-0015) ------------------------------
# Environment name written into exported .verbis packages (dev, test, prod…)
VERBIS_ENVIRONMENT=dev
# Private Ed25519 JWK signing exported packages (leave empty to disable export)
PACKAGE_SIGNING_JWK=
# JWKS of environments whose packages are accepted on import
PACKAGE_TRUSTED_JWKS=
# Resolver snapshot cache TTL in seconds (publish/assignment events invalidate earlier)
RESOLVER_CACHE_TTL_SECONDS=60

# --- Server-side integration engine (never expose to frontend builds) ---------
# Base64 32-byte AES-256 master key, provisioned by your secrets manager.
# Leave empty to disable secret operations. pnpm dev:bootstrap generates a local dev key.
INTEGRATION_MASTER_KEY=
# env (legacy/local) or vault-transit. Transit never falls back to local encryption on failure.
INTEGRATION_KEY_PROVIDER=env
# Fixed Vault origin; production requires HTTPS. No credentials, query or path here.
INTEGRATION_VAULT_ADDRESS=
# Absolute Vault Agent token sink path, regular file with mode 0600. Token itself stays out of env.
INTEGRATION_VAULT_TOKEN_FILE=
INTEGRATION_VAULT_MOUNT=transit
INTEGRATION_VAULT_KEY=verbis-integrations
INTEGRATION_VAULT_NAMESPACE=
INTEGRATION_VAULT_TIMEOUT_MS=5000
# Read old env envelopes ONLY during an explicit migration; requires the old master above.
INTEGRATION_VAULT_ALLOW_LEGACY_DECRYPT=false
# Public Ed25519 JWKS for signed runtime integration session tokens.
INTEGRATION_RUNTIME_JWKS=

# Collaborative designer (ADR-0028). Dedicated listener is loopback-only by default.
# In a container set COLLABORATION_ADDRESS=0.0.0.0 and proxy /collaboration privately.
COLLABORATION_PORT=0
COLLABORATION_ADDRESS=127.0.0.1
COLLABORATION_INTERNAL_URL=http://127.0.0.1:4010

# Analytics (ADR-0031); server only. Supply independent secrets through your secret manager.
ANALYTICS_ENABLED=false
ANALYTICS_STORAGE=postgres
ANALYTICS_PSEUDONYM_KEY=
ANALYTICS_CLICKHOUSE_URL=
ANALYTICS_CLICKHOUSE_USER=
ANALYTICS_CLICKHOUSE_PASSWORD=
ANALYTICS_REPORTS_ENABLED=false
ANALYTICS_SMTP_URL=
ANALYTICS_MAIL_FROM=

# AI is opt-in; operator-approved endpoint/residency catalogue + local PII recognizer required.
AI_ENABLED=false
AI_ENDPOINTS_JSON=[]
AI_REDACTOR_JSON=

# Optional operator-provisioned tenant PSP public-key profiles; never include private keys/PAN.
# See docs/security/OPERATIONS.md. Missing profile disables hosted secure capture.
PSP_TENANT_PROFILES=

# Public build-time flag: metadata-only browser traces and Web Vitals; no secrets.
VITE_OTEL_ENABLED=false

# Deployment: JetStream server quorum must match stream replication. Local single-node = 1.
NATS_STREAM_REPLICAS=1
# Audit worker health-only HTTP listener (no administration surface).
AUDIT_WORKER_HEALTH_PORT=4200
