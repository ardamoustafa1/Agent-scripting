{
  "realm": "verbis-demo",
  "displayName": "Verbis Synthetic Demo",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "bruteForceProtected": true,
  "internationalizationEnabled": true,
  "supportedLocales": ["tr", "en"],
  "defaultLocale": "tr",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      {
        "name": "tenant_admin",
        "description": "Verbis tenant administrator"
      },
      {
        "name": "designer",
        "description": "Script designer"
      },
      {
        "name": "reviewer",
        "description": "Script reviewer / approver"
      },
      {
        "name": "supervisor",
        "description": "Contact center supervisor"
      },
      {
        "name": "agent",
        "description": "Contact center agent"
      },
      {
        "name": "auditor",
        "description": "Read-only audit access"
      }
    ]
  },
  "groups": [
    {
      "name": "demo-0"
    },
    {
      "name": "demo-1"
    },
    {
      "name": "demo-2"
    },
    {
      "name": "demo-3"
    },
    {
      "name": "demo-4"
    }
  ],
  "clients": [
    {
      "clientId": "verbis-demo-bff",
      "name": "Verbis Demo BFF",
      "description": "Confidential OIDC client used server-side by the BFF in apps/api modules/identity (ADR-0004, ADR-0012). Tokens never reach the browser.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${DEMO_OIDC_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": false,
      "redirectUris": [
        "http://localhost:5173/api/auth/oidc/callback",
        "http://localhost:5174/api/auth/oidc/callback",
        "http://localhost:5175/api/auth/oidc/callback"
      ],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*##http://localhost:5174/*##http://localhost:5175/*",
        "backchannel.logout.session.required": "true",
        "backchannel.logout.url": "http://host.docker.internal:4000/auth/oidc/verbis-demo/019c0000-0000-7000-8000-000000000014/backchannel-logout",
        "backchannel.logout.revoke.offline.tokens": "true"
      },
      "defaultClientScopes": ["web-origins", "acr", "profile", "roles", "email", "basic"],
      "optionalClientScopes": ["offline_access"],
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "claim.name": "groups"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "demo-admin",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "admin",
      "email": "yonetici@example.invalid",
      "groups": ["demo-0"],
      "credentials": [
        {
          "type": "password",
          "value": "${DEMO_SMOKE_PASSWORD}",
          "temporary": false
        }
      ]
    },
    {
      "username": "demo-designer",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "designer",
      "email": "tasarimci@example.invalid",
      "groups": ["demo-1"],
      "credentials": [
        {
          "type": "password",
          "value": "${DEMO_SMOKE_PASSWORD}",
          "temporary": false
        }
      ]
    },
    {
      "username": "demo-approver",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "approver",
      "email": "onayci@example.invalid",
      "groups": ["demo-2"],
      "credentials": [
        {
          "type": "password",
          "value": "${DEMO_SMOKE_PASSWORD}",
          "temporary": false
        }
      ]
    },
    {
      "username": "demo-agent",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "agent",
      "email": "agent@example.invalid",
      "groups": ["demo-3"],
      "credentials": [
        {
          "type": "password",
          "value": "${DEMO_SMOKE_PASSWORD}",
          "temporary": false
        }
      ]
    },
    {
      "username": "demo-auditor",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "auditor",
      "email": "denetci@example.invalid",
      "groups": ["demo-4"],
      "credentials": [
        {
          "type": "password",
          "value": "${DEMO_SMOKE_PASSWORD}",
          "temporary": false
        }
      ]
    }
  ]
}
