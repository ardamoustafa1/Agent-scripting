{
  "name": "@verbis/docs-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/generate-reference.mjs && astro dev --host 127.0.0.1 --port 5176",
    "build": "node scripts/generate-reference.mjs && astro build",
    "preview": "astro preview --host 127.0.0.1 --port 5176",
    "typecheck": "astro sync && tsc --noEmit",
    "lint": "eslint --max-warnings=0 scripts *.mjs",
    "test": "node scripts/generate-reference.mjs && node --test scripts/*.spec.mjs",
    "docs:generate": "node scripts/generate-reference.mjs",
    "docs:capture": "node scripts/capture-guides.mjs",
    "clean": "rm -rf dist .astro",
    "e2e": "playwright test --workers=1"
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.5",
    "@verbis/components": "workspace:*",
    "@verbis/expr": "workspace:*",
    "@verbis/ui": "workspace:*",
    "astro": "7.3.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "typescript": "^6.0.3"
  }
}
