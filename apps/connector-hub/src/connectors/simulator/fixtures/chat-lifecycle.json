{
  "name": "simulated chat lifecycle",
  "participant": {
    "platformUserId": "sim-agent-1",
    "platformInteractionId": "sim-demo-chat-1"
  },
  "fixtures": [
    {
      "name": "chat offered",
      "payload": {
        "op": "create",
        "requestId": "r1",
        "at": "2026-10-01T10:00:00.000Z",
        "platformInteractionId": "sim-demo-chat-1",
        "input": {
          "channel": "chat",
          "agentPlatformUserId": "sim-agent-1",
          "agentEmail": "agent@acme.test",
          "queue": "web",
          "customerName": "Ayşe",
          "message": "Siparişim nerede?"
        }
      },
      "expected": [
        {
          "type": "interactionOffered",
          "platformInteractionId": "sim-demo-chat-1",
          "channel": "chat",
          "agent": {
            "id": "sim-agent-1"
          },
          "context": {
            "channel": "chat",
            "customerName": "Ayşe"
          }
        }
      ]
    },
    {
      "name": "agent connects",
      "payload": {
        "op": "action",
        "requestId": "r2",
        "at": "2026-10-01T10:01:00.000Z",
        "platformInteractionId": "sim-demo-chat-1",
        "input": {
          "action": "connect"
        }
      },
      "expected": [
        {
          "type": "connected"
        }
      ]
    },
    {
      "name": "customer writes again",
      "payload": {
        "op": "action",
        "requestId": "r3",
        "at": "2026-10-01T10:02:00.000Z",
        "platformInteractionId": "sim-demo-chat-1",
        "input": {
          "action": "customerMessage",
          "message": "Kargo takip no?"
        }
      },
      "expected": [
        {
          "type": "connected",
          "context": {
            "channel": "chat"
          }
        }
      ]
    },
    {
      "name": "hold",
      "payload": {
        "op": "action",
        "requestId": "r4",
        "at": "2026-10-01T10:03:00.000Z",
        "platformInteractionId": "sim-demo-chat-1",
        "input": {
          "action": "hold"
        }
      },
      "expected": [
        {
          "type": "held"
        }
      ]
    },
    {
      "name": "message while held is recorded, not emitted",
      "payload": {
        "op": "action",
        "requestId": "r5",
        "at": "2026-10-01T10:04:00.000Z",
        "platformInteractionId": "sim-demo-chat-1",
        "input": {
          "action": "customerMessage",
          "message": "Orada mısınız?"
        }
      },
      "expected": []
    },
    {
      "name": "resume",
      "payload": {
        "op": "action",
        "requestId": "r6",
        "at": "2026-10-01T10:05:00.000Z",
        "platformInteractionId": "sim-demo-chat-1",
        "input": {
          "action": "resume"
        }
      },
      "expected": [
        {
          "type": "resumed"
        }
      ]
    },
    {
      "name": "wrap-up",
      "payload": {
        "op": "action",
        "requestId": "r7",
        "at": "2026-10-01T10:06:00.000Z",
        "platformInteractionId": "sim-demo-chat-1",
        "input": {
          "action": "wrapup"
        }
      },
      "expected": [
        {
          "type": "wrapupRequired"
        }
      ]
    },
    {
      "name": "end",
      "payload": {
        "op": "action",
        "requestId": "r8",
        "at": "2026-10-01T10:07:00.000Z",
        "platformInteractionId": "sim-demo-chat-1",
        "input": {
          "action": "end"
        }
      },
      "expected": [
        {
          "type": "ended"
        }
      ]
    }
  ]
}
