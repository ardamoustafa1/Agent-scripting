{
  "name": "@verbis/api",
  "version": "0.0.0",
  "private": true,
  "description": "Verbis core API (NestJS + Fastify). Hosts core domain modules until they are split per docs/ARCHITECTURE.md.",
  "type": "module",
  "scripts": {
    "build": "prisma generate && tsc -b tsconfig.build.json",
    "dev": "concurrently -k -n tsc,api,audit,mtls -c blue,green,magenta,cyan \"tsc -b tsconfig.build.json --watch --preserveWatchOutput\" \"node --watch --env-file-if-exists=../../.env dist/main.js\" \"node --watch --env-file-if-exists=../../.env dist/audit-worker.js\" \"node --watch --env-file-if-exists=../../.env ../../scripts/dev-mtls-proxy.mjs\"",
    "start": "node dist/main.js",
    "lint": "eslint --max-warnings=0 .",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "test": "prisma generate && vitest run --project unit --project integration --coverage",
    "test:unit": "prisma generate && vitest run --project unit",
    "test:integration": "prisma generate && vitest run --project integration",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "db:migrate": "prisma migrate deploy && tsx scripts/db-app-role.ts",
    "db:migrate:dev": "prisma migrate dev && tsx scripts/db-app-role.ts",
    "seed": "prisma generate && prisma db seed",
    "dev:token": "tsx scripts/dev-token.ts",
    "clean": "rm -rf dist coverage src/generated",
    "start:audit-worker": "node dist/audit-worker.js",
    "test:perf": "prisma generate && vitest run --project perf",
    "test:integrations": "prisma generate && vitest run --project unit src/modules/integrations",
    "test:runtime": "prisma generate && vitest run --project unit src/modules/runtime",
    "seed:demo": "tsx prisma/seed-demo.ts"
  },
  "dependencies": {
    "@casl/ability": "^6.8.1",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/otel": "^0.21.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.9.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@hocuspocus/server": "4.7.0",
    "@nats-io/jetstream": "^3.4.0",
    "@nats-io/transport-node": "^3.4.0",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-fastify": "^12.1.2",
    "@nestjs/platform-socket.io": "^12.1.2",
    "@nestjs/websockets": "^12.1.2",
    "@node-rs/argon2": "^2.2.1",
    "@node-saml/node-saml": "^5.1.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/core": "^2.11.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/instrumentation": "^0.222.0",
    "@opentelemetry/instrumentation-http": "^0.222.0",
    "@opentelemetry/instrumentation-ioredis": "^0.70.0",
    "@opentelemetry/instrumentation-pg": "^0.74.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@peculiar/x509": "^2.1.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@prisma/instrumentation": "^7.10.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@verbis/authz": "workspace:*",
    "@verbis/collaboration": "workspace:*",
    "@verbis/components": "workspace:*",
    "@verbis/core-runtime": "workspace:*",
    "@verbis/expr": "workspace:*",
    "@verbis/script-schema": "workspace:^",
    "@verbis/sdk-connector": "workspace:*",
    "@verbis/shared-types": "workspace:*",
    "@xmldom/xmldom": "^0.9.12",
    "ajv": "^8.20.0",
    "bullmq": "^6.3.11",
    "cockatiel": "^4.0.0",
    "exceljs": "4.4.0",
    "fast-xml-builder": "^1.3.1",
    "fast-xml-parser": "^5.11.2",
    "fast-xml-validator": "^1.4.2",
    "fastify": "5.12.5",
    "graphql": "^17.0.2",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "jsonata": "^2.2.2",
    "mammoth": "1.13.0",
    "nodemailer": "10.0.14",
    "openid-client": "^6.8.8",
    "pdfjs-dist": "6.3.289",
    "pg": "^8.23.1",
    "pino": "^10.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.4",
    "undici": "^8.11.2",
    "yjs": "13.6.33",
    "zod": "^4.6.5",
    "@verbis/observability": "workspace:*"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.1.2",
    "@swc/core": "^1.16.13",
    "@testcontainers/postgresql": "^12.2.0",
    "@testcontainers/redis": "^12.2.0",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.23.1",
    "@verbis/config-eslint": "workspace:*",
    "@verbis/config-ts": "workspace:*",
    "@verbis/test-utils": "workspace:*",
    "@vitest/coverage-v8": "^5.0.3",
    "concurrently": "^10.0.5",
    "dotenv": "^18.0.5",
    "eslint": "^9.39.5",
    "fast-check": "^3.23.2",
    "nock": "^14.0.17",
    "prisma": "^7.10.0",
    "testcontainers": "^12.2.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.3",
    "xml-crypto": "^6.3.2",
    "xml-encryption": "^6.0.1"
  }
}
