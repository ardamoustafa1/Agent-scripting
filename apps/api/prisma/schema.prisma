// ─── Secure launch (SECURITY §4) ──────────────────────────────────────────────

enum LaunchIntentState {
  pending
  redeemed
  expired
  revoked

  @@map("launch_intent_state")
}

/// Server-side authority for a launch. Only the SHA-256 of the opaque code is stored.
model LaunchIntent {
  id            String            @id @default(uuid(7)) @db.Uuid
  tenantId      String            @map("tenant_id") @db.Uuid
  userId        String            @map("user_id") @db.Uuid
  interactionId String            @map("interaction_id") @db.Uuid
  connectorId   String?           @map("connector_id") @db.Uuid
  /// `s2s` | `embedded` | `jws`
  flow          String            @db.VarChar(16)
  codeHash      String            @unique(map: "launch_intents_code_hash_key") @map("code_hash") @db.VarChar(64)
  /// External JWS `jti` (CTI-less flow) kept for forensics.
  jti           String?           @db.VarChar(128)
  state         LaunchIntentState @default(pending)
  expiresAt     DateTime          @map("expires_at") @db.Timestamptz(3)
  redeemedAt    DateTime?         @map("redeemed_at") @db.Timestamptz(3)
  sessionId     String?           @map("session_id") @db.Uuid
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy     String            @map("created_by") @db.VarChar(128)
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy     String            @map("updated_by") @db.VarChar(128)
  version       Int               @default(1)
  connectors    Connector?        @relation(fields: [connectorId], references: [id], onUpdate: NoAction)
  interactions  Interaction       @relation(fields: [interactionId], references: [id], onUpdate: NoAction)
  sessions      Session?          @relation(fields: [sessionId], references: [id], onUpdate: NoAction)
  tenants       Tenant            @relation(fields: [tenantId], references: [id], onUpdate: NoAction)
  users         User              @relation(fields: [userId], references: [id], onUpdate: NoAction)

  @@unique([tenantId, jti], map: "launch_intents_tenant_jti_key", where: raw("(jti IS NOT NULL)"))
  @@index([tenantId, userId, state])
  @@index([tenantId, interactionId])
  @@index([tenantId, interactionId, userId], map: "launch_intents_push_dedupe_idx")
  @@map("launch_intents")
}

/// Tenant-registered CTI-less launcher: verifies external JWS launch tokens (JWKS, rotated by kid).
model LaunchTrustedIssuer {
  id        String    @id @default(uuid(7)) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  issuer    String    @db.VarChar(256)
  /// Public JWKS (no private members). Several keys = rotation window.
  jwks      Json
  status    String    @default("active") @db.VarChar(16)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy String    @map("created_by") @db.VarChar(128)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy String    @map("updated_by") @db.VarChar(128)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  version   Int       @default(1)
  tenants   Tenant    @relation(fields: [tenantId], references: [id], onUpdate: NoAction)

  @@unique([tenantId, issuer], map: "launch_trusted_issuers_tenant_issuer_key")
  @@map("launch_trusted_issuers")
}

model AuthoringThread {
  id              String        @id @default(uuid(7)) @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  scriptVersionId String        @map("script_version_id") @db.Uuid
  nodeId          String        @map("node_id") @db.VarChar(128)
  resolved        Boolean       @default(false)
  messages        Json          @default("[]")
  version         Int           @default(1)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
