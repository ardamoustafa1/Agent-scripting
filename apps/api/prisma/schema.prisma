/// Immutable append-only revision of a DataSource (ADR-0042). Written by a DB trigger in the
/// mutation's transaction; secretRefs only, never secret values. Published pins resolve here.
model DataSourceVersion {
  id           String             @id @default(uuid(7)) @db.Uuid
  tenantId     String             @map("tenant_id") @db.Uuid
  dataSourceId String             @map("data_source_id") @db.Uuid
  key          String
  version      Int
  protocol     DataSourceProtocol
  definition   Json
  secretRefs   String[]           @default([]) @map("secret_refs") @db.Uuid
  policy       Json
  contentHash  String             @map("content_hash") @db.Char(64)
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy    String             @map("created_by") @db.VarChar(128)

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  dataSource DataSource @relation(fields: [dataSourceId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([dataSourceId, version], map: "data_source_versions_source_version_key")
  @@index([tenantId, key, version], map: "data_source_versions_tenant_key_idx")
  @@map("data_source_versions")
}

/// Tenant location (site) catalog: the named, stable choices for ABAC `siteIds` role scopes.
model Location {
  id        String    @id @default(uuid(7)) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  /// Stable kebab-case code; unique per tenant among active rows, immutable after creation.
  code      String    @db.VarChar(64)
  name      String
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy String    @map("created_by") @db.VarChar(128)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy String    @map("updated_by") @db.VarChar(128)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  version   Int       @default(1)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, code], map: "locations_tenant_code_active_key", where: raw("deleted_at IS NULL"))
  @@index([tenantId, createdAt, id])
  @@map("locations")
}
