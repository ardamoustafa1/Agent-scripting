// Verbis core schema (docs/DOMAIN.md, ADR-0003, ADR-0011).
//
// Conventions for tenant-owned tables:
//   id (UUIDv7) · tenant_id · created_at/created_by · updated_at/updated_by · deleted_at (soft delete)
//   · version (optimistic locking). Unique keys are partial (`WHERE deleted_at IS NULL`).
// Exceptions (documented in ADR-0011): append-only tables (audit_events, session_events) have no
// update/delete/version columns; infrastructure tables (outbox_events, processed_events,
// idempotency_keys, analytics_event_counts) carry only what their mechanics need.
// Row-Level Security policies, roles, functions and triggers live in raw SQL migrations.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "esm"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum TenantStatus {
  provisioning
  active
  suspended
  deleting

  @@map("tenant_status")
}

enum UserStatus {
  invited
  active
  suspended
  deprovisioned

  @@map("user_status")
}

enum IdpProtocol {
  oidc
  saml

  @@map("idp_protocol")
}

enum IdpStatus {
  draft
  active
  disabled

  @@map("idp_status")
}

enum CampaignStatus {
  draft
  active
  paused
  archived

  @@map("campaign_status")
}

enum ChannelType {
  voice
  chat
  email
  sms
  whatsapp
  social
  video
  callback

  @@map("channel_type")
}

enum ScriptStatus {
  draft
  active
  archived

  @@map("script_status")
}

enum ScriptVersionState {
  draft
  in_review
  approved
  published
  retired

  @@map("script_version_state")
}

enum DocumentEncoding {
  json
  gzip

  @@map("document_encoding")
}

enum DataSourceProtocol {
  rest
  soap
  graphql
  sql

  @@map("datasource_protocol")
}

enum SecretKind {
  password
  api_key
  oauth_client
  certificate
  generic

  @@map("secret_kind")
}

enum ConnectorAdapter {
  genesys_cloud
  genesys_engage
  avaya_aes
  avaya_axp
  avaya_aacc
  amazon_connect
  cisco
  nice_cxone
  five9
  generic

  @@map("connector_adapter")
}

enum ConnectorStatus {
  draft
  active
  disabled
  error

  @@map("connector_status")
}

enum InteractionDirection {
  inbound
  outbound

  @@map("interaction_direction")
}

enum SessionState {
  paused
  launching
  active
  wrapup
  completed
  abandoned
  expired

  @@map("session_state")
}

enum AuditOutcome {
  success
  denied
  failure

  @@map("audit_outcome")
}

enum OutboxStatus {
  pending
  published
  dead

  @@map("outbox_status")
}

enum IdempotencyState {
  in_progress
  completed

  @@map("idempotency_state")
}

// ─── Identity & access ────────────────────────────────────────────────────────

model Tenant {
  id         String       @id @default(uuid(7)) @db.Uuid
  slug       String
  name       String
  region     String
  status     TenantStatus @default(provisioning)
  /// Default locale/theme, session timeouts, retention, allowed CORS origins and egress hosts.
  settings   Json         @default("{}")
  dataKeyRef String?      @map("data_key_ref")
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy  String       @default("system") @map("created_by") @db.VarChar(128)
  updatedAt  DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy  String       @default("system") @map("updated_by") @db.VarChar(128)
  deletedAt  DateTime?    @map("deleted_at") @db.Timestamptz(3)
  version    Int          @default(1)

  users                       User[]
  roles                       Role[]
  userRoles                   UserRole[]
  identityProviders           IdentityProvider[]
  campaigns                   Campaign[]
  scripts                     Script[]
  scriptVersions              ScriptVersion[]
  screens                     Screen[]
  components                  Component[]
  flows                       Flow[]
  variables                   Variable[]
  dataSources                 DataSource[]
  dataSourceVersions          DataSourceVersion[]
  secrets                     Secret[]
  assignments                 Assignment[]
  channels                    Channel[]
  connectors                  Connector[]
  interactions                Interaction[]
  sessions                    Session[]
  sessionEvents               SessionEvent[]
  outcomes                    Outcome[]
  auditEvents                 AuditEvent[]
  auditChainHeads             AuditChainHead[]
  auditCheckpoints            AuditCheckpoint[]
  auditArchives               AuditArchive[]
  siemDestinations            SiemDestination[]
  versionReviews              ScriptVersionReview[]
  sharedScreens               SharedScreen[]
  sharedScreenVersions        SharedScreenVersion[]
  screenLinks                 ScriptScreenLink[]
  templates                   Template[]
  campaignMappings            CampaignExternalMapping[]
  siemCursors                 SiemCursor[]
  sessionChainHeads           SessionChainHead[]
  outboxEvents                OutboxEvent[]
  processedEvents             ProcessedEvent[]
  idempotencyKeys             IdempotencyKey[]
  analyticsCounts             AnalyticsEventCount[]
  userIdentities              UserIdentity[]
  groups                      Group[]
  groupMembers                GroupMember[]
  idpDomains                  IdentityProviderDomain[]
  scimTokens                  ScimToken[]
  serviceClients              ServiceClient[]
  localCredentials            LocalCredential[]
  launchIntents               LaunchIntent[]
  launchTrustedIssuers        LaunchTrustedIssuer[]
  authoringThreads            AuthoringThread[]
  scriptSuggestions           ScriptSuggestion[]
  collaborationConflicts      CollaborationConflict[]
  locations                   Location[]
  collaborationSnapshots      CollaborationSnapshot[]
  scheduledReleases           ScheduledRelease[]
  adminPrivacyRequests        AdminPrivacyRequest[]
  aiCalls                     AiCall[]
  aiUsages                    AiUsage[]
  analyticsErasedSessions     AnalyticsErasedSession[]
  analyticsFacts              AnalyticsFact[]
  analyticsSchedules          AnalyticsSchedule[]
  sessionCapacityReservations SessionCapacityReservation[]

  @@unique([slug], map: "tenants_slug_key")
  @@map("tenants")
}

model User {
  id            String     @id @default(uuid(7)) @db.Uuid
  tenantId      String     @map("tenant_id") @db.Uuid
  /// IdP subject / SCIM externalId.
  externalId    String?    @map("external_id")
  /// @pii
  email         String
  /// @pii
  displayName   String     @map("display_name")
  status        UserStatus @default(invited)
  locale        String     @default("tr")
  /// Platform identities (e.g. Genesys userId) that bind launches to this user.
  ctiIdentities Json       @default("[]") @map("cti_identities")
  lastLoginAt   DateTime?  @map("last_login_at") @db.Timestamptz(3)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy     String     @map("created_by") @db.VarChar(128)
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy     String     @map("updated_by") @db.VarChar(128)
  deletedAt     DateTime?  @map("deleted_at") @db.Timestamptz(3)
  version       Int        @default(1)

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  roles              UserRole[]
  sessions           Session[]
  identities         UserIdentity[]
  groups             GroupMember[]
  localCredential    LocalCredential?
  launchIntents      LaunchIntent[]
  scheduledReleases  ScheduledRelease[]
  analyticsSchedules AnalyticsSchedule[]

  @@unique([tenantId, email], map: "users_tenant_email_active_key", where: raw("deleted_at IS NULL"))
  @@unique([tenantId, externalId], map: "users_tenant_external_id_active_key", where: raw("deleted_at IS NULL AND external_id IS NOT NULL"))
  @@index([tenantId, createdAt, id])
  @@map("users")
}

model Role {
  id          String    @id @default(uuid(7)) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  name        String
  description String?
  /// `action:subject` pairs, e.g. `publish:Script`.
  permissions String[]
  /// CASL rule definitions of a custom role (`@verbis/authz` RuleDefinition[]); system roles use code.
  rules       Json      @default("[]")
  isSystem    Boolean   @default(false) @map("is_system")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy   String    @map("created_by") @db.VarChar(128)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy   String    @map("updated_by") @db.VarChar(128)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  version     Int       @default(1)

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  users  UserRole[]

  @@unique([tenantId, name], map: "roles_tenant_name_active_key", where: raw("deleted_at IS NULL"))
  @@index([tenantId, createdAt, id])
  @@map("roles")
}

model UserRole {
  id        String    @id @default(uuid(7)) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  roleId    String    @map("role_id") @db.Uuid
  /// `manual` (admin API), `claims:<idpId>` (SSO login mapping) or `scim:<idpId>` (SCIM groups).
  source    String    @default("manual") @db.VarChar(64)
  /// ABAC scope of this assignment: `{campaignIds?, teamIds?, siteIds?}` (ids or `"*"`).
  scope     Json      @default("{}")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy String    @map("created_by") @db.VarChar(128)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy String    @map("updated_by") @db.VarChar(128)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  version   Int       @default(1)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, source], map: "user_roles_user_role_source_active_key", where: raw("deleted_at IS NULL"))
  @@index([tenantId, userId])
  @@index([tenantId, roleId])
  @@map("user_roles")
}

model IdentityProvider {
  id              String      @id @default(uuid(7)) @db.Uuid
  tenantId        String      @map("tenant_id") @db.Uuid
  protocol        IdpProtocol
  displayName     String      @map("display_name")
  /// OIDC/SAML settings. Secrets are referenced (`clientSecretRef`), never inlined.
  config          Json        @default("{}")
  domainHints     String[]    @map("domain_hints")
  jitProvisioning Boolean     @default(false) @map("jit_provisioning")
  scimEnabled     Boolean     @default(false) @map("scim_enabled")
  status          IdpStatus   @default(draft)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy       String      @map("created_by") @db.VarChar(128)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy       String      @map("updated_by") @db.VarChar(128)
  deletedAt       DateTime?   @map("deleted_at") @db.Timestamptz(3)
  version         Int         @default(1)

  tenant     Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  identities UserIdentity[]
  domains    IdentityProviderDomain[]
  scimTokens ScimToken[]
  groups     Group[]

  @@index([tenantId, createdAt, id])
  @@map("identity_providers")
}

/// Link between a Verbis user and an IdP subject (OIDC `sub` / SAML NameID).
model UserIdentity {
  id          String    @id @default(uuid(7)) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  idpId       String    @map("idp_id") @db.Uuid
  /// IdP subject; opaque, not shown in UIs.
  subject     String    @db.VarChar(512)
  lastLoginAt DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy   String    @map("created_by") @db.VarChar(128)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy   String    @map("updated_by") @db.VarChar(128)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  version     Int       @default(1)

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  idp    IdentityProvider @relation(fields: [idpId], references: [id], onDelete: Restrict)

  @@unique([tenantId, idpId, subject], map: "user_identities_idp_subject_active_key", where: raw("deleted_at IS NULL"))
  @@index([tenantId, userId])
  @@map("user_identities")
}

/// Email domain claimed by an IdP for home-realm discovery; unique across all tenants.
model IdentityProviderDomain {
  id        String    @id @default(uuid(7)) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  idpId     String    @map("idp_id") @db.Uuid
  /// Lower-case DNS name.
  domain    String    @db.VarChar(253)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy String    @map("created_by") @db.VarChar(128)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy String    @map("updated_by") @db.VarChar(128)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  version   Int       @default(1)

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  idp    IdentityProvider @relation(fields: [idpId], references: [id], onDelete: Restrict)

  @@unique([domain], map: "identity_provider_domains_domain_active_key", where: raw("deleted_at IS NULL"))
  @@index([tenantId, idpId])
  @@map("identity_provider_domains")
}

/// Group provisioned by SCIM (or referenced by role-mapping rules).
model Group {
  id          String    @id @default(uuid(7)) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  idpId       String?   @map("idp_id") @db.Uuid
  externalId  String?   @map("external_id")
  displayName String    @map("display_name")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy   String    @map("created_by") @db.VarChar(128)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy   String    @map("updated_by") @db.VarChar(128)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  version     Int       @default(1)

  tenant  Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  idp     IdentityProvider? @relation(fields: [idpId], references: [id], onDelete: Restrict)
  members GroupMember[]

  @@unique([tenantId, displayName], map: "groups_tenant_display_name_active_key", where: raw("deleted_at IS NULL"))
  @@index([tenantId, createdAt, id])
  @@map("groups")
}

model GroupMember {
  id        String    @id @default(uuid(7)) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  groupId   String    @map("group_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy String    @map("created_by") @db.VarChar(128)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy String    @map("updated_by") @db.VarChar(128)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  version   Int       @default(1)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  group  Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId], map: "group_members_group_user_active_key", where: raw("deleted_at IS NULL"))
  @@index([tenantId, userId])
  @@map("group_members")
}

/// SCIM 2.0 bearer credential (SECURITY §5.4). Only the SHA-256 of the token is stored.
model ScimToken {
  id         String    @id @default(uuid(7)) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  idpId      String    @map("idp_id") @db.Uuid
  /// @secret SHA-256 (hex) of the high-entropy token.
  tokenHash  String    @map("token_hash") @db.Char(64)
  /// First characters of the token, for identification in UIs.
  prefix     String    @db.VarChar(16)
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz(3)
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy  String    @map("created_by") @db.VarChar(128)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy  String    @map("updated_by") @db.VarChar(128)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(3)
  version    Int       @default(1)

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  idp    IdentityProvider @relation(fields: [idpId], references: [id], onDelete: Restrict)

  @@unique([tokenHash], map: "scim_tokens_token_hash_key")
  @@index([tenantId, idpId])
  @@map("scim_tokens")
}

enum ServiceClientAuthMethod {
  client_secret_basic
  client_secret_post
  tls_client_auth

  @@map("service_client_auth_method")
}

enum ServiceClientStatus {
  active
  disabled

  @@map("service_client_status")
}

/// OAuth 2.0 client-credentials client for service-to-service calls (connectors).
model ServiceClient {
  id                    String                  @id @default(uuid(7)) @db.Uuid
  tenantId              String                  @map("tenant_id") @db.Uuid
  name                  String
  authMethod            ServiceClientAuthMethod @map("auth_method")
  /// @secret SHA-256 (hex) of the high-entropy client secret (secret-based methods).
  secretHash            String?                 @map("secret_hash") @db.Char(64)
  /// RFC 8705 `x5t#S256` of the bound client certificate (tls_client_auth, or optional binding).
  certificateThumbprint String?                 @map("certificate_thumbprint") @db.VarChar(64)
  /// Permissions this client may request, `action:Subject`.
  scopes                String[]
  status                ServiceClientStatus     @default(active)
  lastUsedAt            DateTime?               @map("last_used_at") @db.Timestamptz(3)
  createdAt             DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy             String                  @map("created_by") @db.VarChar(128)
  updatedAt             DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy             String                  @map("updated_by") @db.VarChar(128)
  deletedAt             DateTime?               @map("deleted_at") @db.Timestamptz(3)
  version               Int                     @default(1)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, name], map: "service_clients_tenant_name_active_key", where: raw("deleted_at IS NULL"))
  @@index([tenantId, createdAt, id])
  @@map("service_clients")
}

enum LocalCredentialStatus {
  pending_mfa
  active
  disabled

  @@map("local_credential_status")
}

/// Break-glass local administrator credential: argon2id password + mandatory TOTP.
model LocalCredential {
  id             String                @id @default(uuid(7)) @db.Uuid
  tenantId       String                @map("tenant_id") @db.Uuid
  userId         String                @map("user_id") @db.Uuid
  /// @secret argon2id PHC string.
  passwordHash   String                @map("password_hash")
  /// @secret AES-256-GCM sealed TOTP seed.
  totpSecret     String                @map("totp_secret")
  /// Last accepted TOTP time step (replay protection).
  totpLastStep   BigInt?               @map("totp_last_step")
  status         LocalCredentialStatus @default(pending_mfa)
  failedAttempts Int                   @default(0) @map("failed_attempts")
  lockedUntil    DateTime?             @map("locked_until") @db.Timestamptz(3)
  lastUsedAt     DateTime?             @map("last_used_at") @db.Timestamptz(3)
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy      String                @map("created_by") @db.VarChar(128)
  updatedAt      DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy      String                @map("updated_by") @db.VarChar(128)
  deletedAt      DateTime?             @map("deleted_at") @db.Timestamptz(3)
  version        Int                   @default(1)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId], map: "local_credentials_user_key")
  @@index([tenantId, createdAt, id])
  @@map("local_credentials")
}

// ─── Routing ──────────────────────────────────────────────────────────────────

model Campaign {
  id            String         @id @default(uuid(7)) @db.Uuid
  tenantId      String         @map("tenant_id") @db.Uuid
  name          String
  description   String?
  status        CampaignStatus @default(draft)
  /// Stable business code (A-Z0-9_-), unique per tenant.
  code          String?        @db.VarChar(64)
  defaultLocale String         @default("tr") @map("default_locale")
  locales       String[]       @default([])
  /// {timezone, weekly: {mon: [{from, to}]…}, holidays: [YYYY-MM-DD]}
  workingHours  Json?          @map("working_hours")
  /// [{code, label, category, requiresNote, subCodes}]
  outcomeSet    Json           @default("[]") @map("outcome_set")
  channels      ChannelType[]
  queues        String[]
  startsAt      DateTime?      @map("starts_at") @db.Timestamptz(3)
  endsAt        DateTime?      @map("ends_at") @db.Timestamptz(3)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy     String         @map("created_by") @db.VarChar(128)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy     String         @map("updated_by") @db.VarChar(128)
  deletedAt     DateTime?      @map("deleted_at") @db.Timestamptz(3)
  version       Int            @default(1)

  tenant       Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  assignments  Assignment[]
  interactions Interaction[]
  mappings     CampaignExternalMapping[]

  @@unique([tenantId, code], map: "campaigns_tenant_code_key", where: raw("deleted_at IS NULL AND code IS NOT NULL"))
  @@unique([tenantId, name], map: "campaigns_tenant_name_active_key", where: raw("deleted_at IS NULL"))
  @@index([tenantId, createdAt, id])
  @@index([tenantId, name, id])
  @@map("campaigns")
}

model Assignment {
  id              String    @id @default(uuid(7)) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  scriptId        String    @map("script_id") @db.Uuid
  campaignId      String    @map("campaign_id") @db.Uuid
  /// Lower wins.
  priority        Int       @default(100)
  validFrom       DateTime? @map("valid_from") @db.Timestamptz(3)
  validTo         DateTime? @map("valid_to") @db.Timestamptz(3)
  /// No-code predicate (SCRIPT_MODEL §6 format).
  rule            Json?
  pinnedVersionId String?   @map("pinned_version_id") @db.Uuid
  /// pinned | latestPublished
  versionPolicy   String    @default("latestPublished") @map("version_policy")
  /// {channels, locales, queues, skills, segments}; empty = any. `rule` is the expression.
  conditions      Json      @default("{}")
  /// A/B variants: [{key, weight (basis points), pinnedVersionId?}]
  abTest          Json?     @map("ab_test")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy       String    @map("created_by") @db.VarChar(128)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy       String    @map("updated_by") @db.VarChar(128)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(3)
  version         Int       @default(1)

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  script        Script         @relation(fields: [scriptId], references: [id], onDelete: Restrict)
  campaign      Campaign       @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  pinnedVersion ScriptVersion? @relation(fields: [pinnedVersionId], references: [id], onDelete: Restrict)
  sessions      Session[]

  @@index([tenantId, scriptId], map: "assignments_tenant_script_active_idx", where: raw("deleted_at IS NULL"))
  @@index([tenantId, campaignId, priority])
  @@index([tenantId, createdAt, id])
  @@map("assignments")
}

// ─── Authoring ────────────────────────────────────────────────────────────────

model Script {
  id               String       @id @default(uuid(7)) @db.Uuid
  tenantId         String       @map("tenant_id") @db.Uuid
  name             String
  description      String?
  status           ScriptStatus @default(draft)
  tags             String[]
  currentVersionId String?      @map("current_version_id") @db.Uuid
  /// Overrides tenants.settings.authoring.approval.
  approvalPolicy   Json?        @map("approval_policy")
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy        String       @map("created_by") @db.VarChar(128)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy        String       @map("updated_by") @db.VarChar(128)
  deletedAt        DateTime?    @map("deleted_at") @db.Timestamptz(3)
  version          Int          @default(1)

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  versions          ScriptVersion[]
  assignments       Assignment[]
  scheduledReleases ScheduledRelease[]

  @@unique([tenantId, name], map: "scripts_tenant_name_active_key", where: raw("deleted_at IS NULL"))
  @@index([tenantId, createdAt, id])
  @@index([tenantId, name, id])
  @@map("scripts")
}

model ScriptVersion {
  id                 String             @id @default(uuid(7)) @db.Uuid
  tenantId           String             @map("tenant_id") @db.Uuid
  scriptId           String             @map("script_id") @db.Uuid
  number             Int
  state              ScriptVersionState @default(draft)
  schemaVersion      String             @map("schema_version")
  /// Script document (JSONB). Null when stored compressed in `documentCompressed`.
  document           Json?
  /// gzip of the canonical JSON for large documents (ADR-0011).
  documentCompressed Bytes?             @map("document_compressed")
  documentEncoding   DocumentEncoding   @default(json) @map("document_encoding")
  /// Uncompressed UTF-8 size in bytes.
  documentSize       Int                @map("document_size")
  /// SHA-256 (hex) of the canonical JSON.
  checksum           String
  publishedAt        DateTime?          @map("published_at") @db.Timestamptz(3)
  publishedBy        String?            @map("published_by") @db.VarChar(128)
  /// Semantic version, set on submit (unique per script).
  semver             String?            @db.VarChar(64)
  changeNote         String?            @map("change_note")
  submittedAt        DateTime?          @map("submitted_at") @db.Timestamptz(3)
  submittedBy        String?            @map("submitted_by") @db.VarChar(128)
  approvedAt         DateTime?          @map("approved_at") @db.Timestamptz(3)
  retiredAt          DateTime?          @map("retired_at") @db.Timestamptz(3)
  retiredBy          String?            @map("retired_by") @db.VarChar(128)
  /// Increments on every submit; reviews count only for the current round.
  reviewRound        Int                @default(0) @map("review_round")
  /// Provenance of imported versions (.verbis package).
  source             Json?
  /// Branch label (ADR-0051). A branch has exactly one working version; branches never publish.
  branch             String?            @db.VarChar(64)
  /// The version a branch was created from; the common ancestor for the merge back.
  parentVersionId    String?            @map("parent_version_id") @db.Uuid
  parent             ScriptVersion?     @relation("ScriptVersionBranch", fields: [parentVersionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  children           ScriptVersion[]    @relation("ScriptVersionBranch")
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy          String             @map("created_by") @db.VarChar(128)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy          String             @map("updated_by") @db.VarChar(128)
  deletedAt          DateTime?          @map("deleted_at") @db.Timestamptz(3)
  version            Int                @default(1)

  tenant                 Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  script                 Script                  @relation(fields: [scriptId], references: [id], onDelete: Restrict)
  screens                Screen[]
  flows                  Flow[]
  variables              Variable[]
  assignments            Assignment[]
  sessions               Session[]
  reviews                ScriptVersionReview[]
  screenLinks            ScriptScreenLink[]
  authoringThreads       AuthoringThread[]
  suggestions            ScriptSuggestion[]
  collaborationConflicts CollaborationConflict[]
  collaborationSnapshots CollaborationSnapshot[]

  @@unique([scriptId, branch], map: "script_versions_branch_key", where: raw("branch IS NOT NULL AND deleted_at IS NULL"))
  @@unique([scriptId, number], map: "script_versions_script_number_key")
  @@unique([scriptId, semver], map: "script_versions_script_semver_key", where: raw("semver IS NOT NULL AND deleted_at IS NULL"))
  @@index([tenantId, scriptId, number])
  @@map("script_versions")
}

/// Read model projected from ScriptVersion.document (pages) for querying and diff.
model Screen {
  id              String    @id @default(uuid(7)) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  scriptVersionId String    @map("script_version_id") @db.Uuid
  key             String
  title           String?
  layoutRoot      Json      @map("layout_root")
  entry           Boolean   @default(false)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy       String    @map("created_by") @db.VarChar(128)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy       String    @map("updated_by") @db.VarChar(128)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(3)
  version         Int       @default(1)

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  scriptVersion ScriptVersion @relation(fields: [scriptVersionId], references: [id], onDelete: Cascade)
  components    Component[]

  @@unique([scriptVersionId, key], map: "screens_version_key")
  @@index([tenantId, createdAt, id])
  @@map("screens")
}

/// Read model: one row per layout node.
model Component {
  id        String    @id @default(uuid(7)) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  screenId  String    @map("screen_id") @db.Uuid
  key       String
  type      String
  props     Json      @default("{}")
  bindings  Json      @default("[]")
  events    Json      @default("{}")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy String    @map("created_by") @db.VarChar(128)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy String    @map("updated_by") @db.VarChar(128)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  version   Int       @default(1)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  screen Screen @relation(fields: [screenId], references: [id], onDelete: Cascade)

  @@unique([screenId, key], map: "components_screen_key")
  @@index([tenantId, type])
  @@map("components")
}

/// Read model projected from the document's flow and subflows.
model Flow {
  id              String    @id @default(uuid(7)) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  scriptVersionId String    @map("script_version_id") @db.Uuid
  key             String
  nodes           Json
  edges           Json
  /// Start node id, or a richer trigger definition in later schema versions.
  trigger         Json?
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy       String    @map("created_by") @db.VarChar(128)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy       String    @map("updated_by") @db.VarChar(128)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(3)
  version         Int       @default(1)

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  scriptVersion ScriptVersion @relation(fields: [scriptVersionId], references: [id], onDelete: Cascade)

  @@unique([scriptVersionId, key], map: "flows_version_key")
  @@map("flows")
}

/// Read model projected from the document's variables.
model Variable {
  id              String    @id @default(uuid(7)) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  scriptVersionId String    @map("script_version_id") @db.Uuid
  name            String
  type            String
  scope           String
  classification  String
  defaultValue    Json?     @map("default_value")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy       String    @map("created_by") @db.VarChar(128)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy       String    @map("updated_by") @db.VarChar(128)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(3)
  version         Int       @default(1)

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  scriptVersion ScriptVersion @relation(fields: [scriptVersionId], references: [id], onDelete: Cascade)

  @@unique([scriptVersionId, name], map: "variables_version_name")
  @@index([tenantId, classification])
  @@map("variables")
}

// ─── Integration ──────────────────────────────────────────────────────────────

model DataSource {
