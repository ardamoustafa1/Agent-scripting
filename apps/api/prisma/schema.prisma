  tenantId     String               @map("tenant_id") @db.Uuid
  externalId   String               @map("external_id")
  channelType  ChannelType          @map("channel_type")
  connectorId  String?              @map("connector_id") @db.Uuid
  direction    InteractionDirection
  queue        String?
  campaignId   String?              @map("campaign_id") @db.Uuid
  startedAt    DateTime             @map("started_at") @db.Timestamptz(3)
  endedAt      DateTime?            @map("ended_at") @db.Timestamptz(3)
  /// @pii
  participants Json                 @default("[]")
  /// @pii Platform attributes (ani/dnis, attached data).
  attributes   Json                 @default("{}")
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy    String               @map("created_by") @db.VarChar(128)
  updatedAt    DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy    String               @map("updated_by") @db.VarChar(128)
  deletedAt    DateTime?            @map("deleted_at") @db.Timestamptz(3)
  version      Int                  @default(1)

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  connector     Connector?     @relation(fields: [connectorId], references: [id], onDelete: SetNull)
  campaign      Campaign?      @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  sessions      Session[]
  launchIntents LaunchIntent[]

  @@unique([tenantId, connectorId, externalId], map: "interactions_connector_external_key")
  @@index([tenantId, createdAt, id])
  @@map("interactions")
}

/// Short-lived internal admission leases; session INSERT consumes the lease transactionally.
model SessionCapacityReservation {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, expiresAt])
  @@map("session_capacity_reservations")
}

model Session {
  /// `interaction` (secure launch) or `preview` (designer test run; never a real interaction).
  kind            String       @default("interaction") @db.VarChar(16)
  sequence        Int          @default(0)
  teamId          String?      @map("team_id") @db.Uuid
  writerHash      String?      @map("writer_hash") @db.VarChar(64)
  writerTabId     String?      @map("writer_tab_id") @db.Uuid
  writerBffId     String?      @map("writer_bff_id") @db.Uuid
  writerUntil     DateTime?    @map("writer_until") @db.Timestamptz(3)
  expiresAt       DateTime?    @map("expires_at") @db.Timestamptz(3)
  id              String       @id @default(uuid(7)) @db.Uuid
  tenantId        String       @map("tenant_id") @db.Uuid
  interactionId   String?      @map("interaction_id") @db.Uuid
  userId          String       @map("user_id") @db.Uuid
  scriptVersionId String       @map("script_version_id") @db.Uuid
  assignmentId    String?      @map("assignment_id") @db.Uuid
  state           SessionState @default(launching)
  startedAt       DateTime     @default(now()) @map("started_at") @db.Timestamptz(3)
  endedAt         DateTime?    @map("ended_at") @db.Timestamptz(3)
  /// Classification-filtered variable snapshot (no pci).
  variables       Json         @default("{}")
  decisionTrace   Json?        @map("decision_trace")
  /// Checksum of the pinned script version document.
  checksum        String
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy       String       @map("created_by") @db.VarChar(128)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy       String       @map("updated_by") @db.VarChar(128)
  deletedAt       DateTime?    @map("deleted_at") @db.Timestamptz(3)
  version         Int          @default(1)

  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  interaction   Interaction?      @relation(fields: [interactionId], references: [id], onDelete: SetNull)
  user          User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  scriptVersion ScriptVersion     @relation(fields: [scriptVersionId], references: [id], onDelete: Restrict)
  assignment    Assignment?       @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  events        SessionEvent[]
  chainHead     SessionChainHead?
  outcome       Outcome?
  launchIntents LaunchIntent[]

  @@index([tenantId, createdAt, id])
  @@index([tenantId, userId, state])
  @@index([tenantId, state], map: "sessions_tenant_active_idx", where: raw("(deleted_at IS NULL)"))
  @@index([tenantId, interactionId], map: "sessions_interaction_idx", where: raw("(deleted_at IS NULL)"))
  @@index([tenantId, expiresAt], map: "sessions_runtime_expiry", where: raw("(deleted_at IS NULL)"))
  @@map("sessions")
}

/// Append-only (no UPDATE/DELETE; trigger-enforced).
/// Runtime session stream: append-only, hash-chained per session, partitioned by `recorded_at`.
model SessionEvent {
  id         String   @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  sessionId  String   @map("session_id") @db.Uuid
  seq        Int
  type       String
  /// Redacted per variable classification before insert.
  payload    Json     @default("{}")
  actorId    String?  @map("actor_id") @db.VarChar(128)
  pageId     String?  @map("page_id")
  occurredAt DateTime @map("occurred_at") @db.Timestamptz(3)
  recordedAt DateTime @map("recorded_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy  String   @map("created_by") @db.VarChar(128)
  prevHash   String   @map("prev_hash") @db.Char(64)
  hash       String   @db.Char(64)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onUpdate: NoAction, map: "session_events_tenant_id_fkey1", onDelete: Restrict)
  session Session @relation(fields: [sessionId], references: [id], onUpdate: NoAction, map: "session_events_session_id_fkey1", onDelete: Restrict)

  @@id([sessionId, seq, recordedAt], map: "session_events_pkey")
  @@unique([id, recordedAt], map: "session_events_id_key")
  @@index([tenantId, occurredAt], map: "session_events_tenant_occurred_idx")
  @@map("session_events")
}

model SessionChainHead {
  sessionId  String    @id @map("session_id") @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  seq        Int       @default(0)
  hash       String    @db.Char(64)
  recordedAt DateTime  @default(dbgenerated("'1970-01-01 00:00:00+00'::timestamp with time zone")) @map("recorded_at") @db.Timestamptz(3)
  sealedAt   DateTime? @map("sealed_at") @db.Timestamptz(3)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onUpdate: NoAction, onDelete: Restrict)
  session Session @relation(fields: [sessionId], references: [id], onUpdate: NoAction, onDelete: Restrict)

  @@index([tenantId, recordedAt], map: "session_chain_heads_tenant_recorded_idx")
  @@map("session_chain_heads")
}

model Outcome {
  sealedData String?   @map("sealed_data")
  id         String    @id @default(uuid(7)) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  sessionId  String    @map("session_id") @db.Uuid
  code       String
  label      String?
  subCodes   String[]  @map("sub_codes")
  /// @pii
  notes      String?
  callbackAt DateTime? @map("callback_at") @db.Timestamptz(3)
  recordedAt DateTime  @default(now()) @map("recorded_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy  String    @map("created_by") @db.VarChar(128)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy  String    @map("updated_by") @db.VarChar(128)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(3)
  version    Int       @default(1)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  session Session @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@unique([sessionId], map: "outcomes_session_key")
  @@index([tenantId, code, recordedAt])
  @@map("outcomes")
}

// ─── Governance ───────────────────────────────────────────────────────────────

/// Append-only, hash-chained per tenant (CLAUDE.md §6, DOMAIN AuditEvent).
/// Append-only, hash-chained, partitioned monthly by `recorded_at` (ADR-0014; reviewed SQL).
model AuditEvent {
  /// ULID (hash v2); migrated v1 rows keep their UUID.
  id            String                   @db.VarChar(36)
  tenantId      String                   @map("tenant_id") @db.Uuid
  seq           BigInt
  hashVersion   Int                      @default(2) @map("hash_version") @db.SmallInt
  action        String
  /// user | system | apiClient | connector (`service` only on v1 rows).
  actorType     String                   @map("actor_type")
  actorId       String                   @map("actor_id") @db.VarChar(128)
  /// displayName (@pii), ip (@pii), userAgent, sessionId.
  actor         Json                     @default("{}")
  targetType    String                   @map("target_type")
  targetId      String                   @map("target_id")
  targetName    String?                  @map("target_name")
  outcome       AuditOutcome
  reason        String?
  /// Redacted snapshot diff or RFC 6902 patch.
  diff          Json?
  correlationId String                   @map("correlation_id")
  interactionId String?                  @map("interaction_id")
  metadata      Json                     @default("{}")
  occurredAt    DateTime                 @map("occurred_at") @db.Timestamptz(3)
  recordedAt    DateTime                 @map("recorded_at") @db.Timestamptz(3)
  prevHash      String                   @map("prev_hash") @db.Char(64)
  hash          String                   @db.Char(64)
  search        Unsupported("tsvector")?

  tenant Tenant @relation(fields: [tenantId], references: [id], onUpdate: NoAction, map: "audit_events_tenant_id_fkey1", onDelete: Restrict)

  @@id([tenantId, seq, recordedAt], map: "audit_events_pkey")
  @@unique([id, recordedAt], map: "audit_events_id_key")
  @@index([tenantId, occurredAt(sort: Desc)], map: "audit_events_tenant_occurred_idx")
  @@index([tenantId, targetType, targetId], map: "audit_events_tenant_target_idx")
  @@index([tenantId, actorType, actorId], map: "audit_events_tenant_actor_idx")
  @@index([tenantId, action], map: "audit_events_tenant_action_idx")
  @@index([tenantId, correlationId], map: "audit_events_tenant_correlation_idx")
  @@map("audit_events")
}

/// Per-tenant chain head (row lock serializes appends). A cache: verification never trusts it.
model AuditChainHead {
  tenantId   String   @id @map("tenant_id") @db.Uuid
  seq        BigInt   @default(0)
  hash       String   @db.Char(64)
  recordedAt DateTime @default(dbgenerated("'1970-01-01 00:00:00+00'::timestamp with time zone")) @map("recorded_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onUpdate: NoAction, onDelete: Restrict)

  @@map("audit_chain_heads")
}

/// Ed25519-signed chain head (append-only).
model AuditCheckpoint {
  id                 String   @id @db.VarChar(26)
  tenantId           String   @map("tenant_id") @db.Uuid
  seq                BigInt
  hash               String   @db.Char(64)
  sessionHeadsDigest String   @map("session_heads_digest") @db.Char(64)
  sessionHeadsCount  Int      @default(0) @map("session_heads_count")
  prevCheckpointId   String?  @map("prev_checkpoint_id") @db.VarChar(26)
  keyId              String   @map("key_id")
  signature          String
  signedAt           DateTime @map("signed_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onUpdate: NoAction, onDelete: Restrict)

  @@unique([tenantId, seq], map: "audit_checkpoints_tenant_seq_key")
  @@map("audit_checkpoints")
}

/// WORM archive registry (append-only): `uploaded` then `verified` rows per partition.
model AuditArchive {
  id            String   @id @db.VarChar(26)
  tenantId      String   @map("tenant_id") @db.Uuid
  stream        String
  partitionName String   @map("partition_name")
  fromSeq       BigInt?  @map("from_seq")
  toSeq         BigInt?  @map("to_seq")
  rowCount      BigInt   @map("row_count")
  objectKey     String   @map("object_key")
  sha256        String   @db.Char(64)
  retainUntil   DateTime @map("retain_until") @db.Timestamptz(3)
  status        String
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onUpdate: NoAction, onDelete: Restrict)

  @@unique([tenantId, stream, partitionName, status], map: "audit_archives_unique")
  @@map("audit_archives")
}

model SiemDestination {
