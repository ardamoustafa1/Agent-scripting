// ─── Infrastructure ───────────────────────────────────────────────────────────

/// Transactional outbox: written in the same transaction as the domain change.
model OutboxEvent {
  id            String       @id @default(uuid(7)) @db.Uuid
  tenantId      String       @map("tenant_id") @db.Uuid
  aggregateType String       @map("aggregate_type")
  aggregateId   String       @map("aggregate_id")
  /// NATS subject, e.g. `verbis.campaigns.campaign.created.v1`.
  eventType     String       @map("event_type")
  payload       Json
  /// correlationId, traceparent, actor.
  headers       Json         @default("{}")
  status        OutboxStatus @default(pending)
  attempts      Int          @default(0)
  availableAt   DateTime     @default(now()) @map("available_at") @db.Timestamptz(3)
  lockedUntil   DateTime?    @map("locked_until") @db.Timestamptz(3)
  publishedAt   DateTime?    @map("published_at") @db.Timestamptz(3)
  lastError     String?      @map("last_error")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy     String       @map("created_by") @db.VarChar(128)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([status, availableAt], map: "outbox_events_pending_idx", where: raw("status = 'pending'"))
  @@index([tenantId, createdAt])
  @@map("outbox_events")
}

/// Idempotent consumers: one row per (consumer, event) processed.
model ProcessedEvent {
  consumer    String
  eventId     String   @map("event_id") @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@id([consumer, eventId])
  @@index([tenantId, processedAt])
  @@map("processed_events")
}

/// Idempotency-Key records for POST requests (24h by default).
model IdempotencyKey {
  id              String           @id @default(uuid(7)) @db.Uuid
  tenantId        String           @map("tenant_id") @db.Uuid
  principalId     String           @map("principal_id") @db.VarChar(128)
  key             String           @db.VarChar(255)
  method          String           @db.VarChar(10)
  path            String
  requestHash     String           @map("request_hash")
  state           IdempotencyState @default(in_progress)
  responseStatus  Int?             @map("response_status")
  responseBody    Json?            @map("response_body")
  responseHeaders Json?            @map("response_headers")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt       DateTime         @map("expires_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, principalId, key], map: "idempotency_keys_scope_key")
  @@index([expiresAt])
  @@map("idempotency_keys")
}

/// Analytics read model fed by the idempotent domain-event consumer.
model AnalyticsEventCount {
  tenantId  String   @map("tenant_id") @db.Uuid
  eventType String   @map("event_type")
  day       DateTime @db.Date
  count     Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@id([tenantId, eventType, day])
  @@map("analytics_event_counts")
}

/// Review trail of a script version (append-only).
