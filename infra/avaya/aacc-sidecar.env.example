# Avaya sidecar — AACC mode
VERBIS_CONNECTOR_ID=00000000-0000-4000-8000-000000000000
SIDECAR_SOURCE=aacc
SIDECAR_AGENT_IDENTITY=handle
NATS_SERVERS=tls://nats.acme.internal:4222
NATS_CREDS_FILE=/run/secrets/nats.creds
AACC_CCMM_URL=https://ccmm.acme.internal/ccmmwebservices/
AACC_CCMM_USER=verbis_ws
AACC_CCMM_PASSWORD_FILE=/run/secrets/ccmm-password
AACC_NOTIFY_TOKEN_FILE=/run/secrets/cct-notify-token
AACC_INTRINSICS_ALLOW=CustomerId,Priority,Language
OUTBOUND_SYSTEM=none
