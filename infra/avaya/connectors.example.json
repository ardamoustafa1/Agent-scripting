{
  "$comment": "Example connectors.config per Avaya adapter (non-secret). Secrets via vault: natsCreds, recorderSecret (sidecar); clientId, clientSecret, appKey, recorderSecret (AXP).",
  "avaya_aes": {
    "kind": "sidecar",
    "nats": { "servers": ["tls://nats.acme.internal:4222"] },
    "agentIdentity": "loginId",
    "uui": { "format": "kv", "allow": ["cust", "seg", "lang"] },
    "outbound": {
      "completionCodes": { "SALE": "SALE_OK", "NO_SALE": "REFUSED" },
      "fields": ["firstName", "balance"]
    },
    "recording": { "url": "https://recorder-adapter.acme.internal/verbis", "callKey": "ucid" }
  },
  "avaya_aacc": {
    "kind": "sidecar",
    "nats": { "servers": ["tls://nats.acme.internal:4222"] },
    "agentIdentity": "handle",
    "intrinsics": ["CustomerId", "Priority", "Language"],
    "dispositionCodes": { "SALE": "101", "NO_SALE": "102" },
    "recording": { "url": "https://recorder-adapter.acme.internal/verbis" }
  },
  "avaya_axp": {
    "kind": "workspaces",
    "host": "na.api.avayacloud.com",
    "accountId": "ACME01",
    "agentIdentity": "loginId",
    "dispositionCodes": { "SALE": "Resolved" },
    "afterContactWork": true
  }
}
