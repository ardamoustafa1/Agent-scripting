# Avaya sidecar — AES mode (values are examples; secrets are mounted files, never env values)
VERBIS_CONNECTOR_ID=00000000-0000-4000-8000-000000000000
SIDECAR_SOURCE=aes
SIDECAR_AGENT_IDENTITY=loginId
NATS_SERVERS=tls://nats.acme.internal:4222
NATS_CREDS_FILE=/run/secrets/nats.creds
AES_TLINK=AVAYA#CM01#CSTA-S#AES01
AES_SERVERS=aes01.acme.internal:450
AES_USER=verbis_ctiuser
AES_PASSWORD_FILE=/run/secrets/aes-password
AES_EXTENSIONS=4001,4002,4003
AES_VDNS=7001,7002
OUTBOUND_SYSTEM=pom
POM_URL=https://pom.acme.internal/VP_POM_Service/services/POMWS
POM_TOKEN_FILE=/run/secrets/pom-token
