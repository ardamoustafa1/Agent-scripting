{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["global", "services", "migration", "ingress", "networkPolicy"],
  "properties": {
    "global": {
      "type": "object",
      "required": ["production"],
      "properties": {
        "production": {
          "type": "boolean"
        }
      }
    },
    "services": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "enabled",
          "image",
          "replicas",
          "port",
          "resources",
          "autoscaling",
          "pdb",
          "env",
          "existingSecret",
          "entrypoint",
          "livenessPath",
          "readinessPath",
          "mountSecret"
        ],
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "image": {
            "type": "object",
            "required": ["repository", "tag", "digest"],
            "properties": {
              "repository": {
                "type": "string",
                "minLength": 1
              },
              "tag": {
                "type": "string",
                "minLength": 1
              },
              "digest": {
                "type": "string",
                "pattern": "^$|^sha256:[a-f0-9]{64}$"
              }
            },
            "additionalProperties": false
          },
          "replicas": {
            "type": "integer",
            "minimum": 1
          },
          "port": {
            "type": "integer",
            "minimum": 1024,
            "maximum": 65535
          },
          "env": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "resources": {
            "type": "object",
            "required": ["requests", "limits"]
          },
          "autoscaling": {
            "type": "object",
            "required": ["enabled", "minReplicas", "maxReplicas", "cpu"],
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "minReplicas": {
                "type": "integer",
                "minimum": 1
              },
              "maxReplicas": {
                "type": "integer",
                "minimum": 2
              },
              "cpu": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              }
            }
          }
        }
      }
    },
    "migration": {
      "type": "object",
      "properties": {
        "image": {
          "type": "object",
          "required": ["repository", "tag", "digest"],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string",
              "minLength": 1
            },
            "digest": {
              "type": "string",
              "pattern": "^$|^sha256:[a-f0-9]{64}$"
            }
          },
          "additionalProperties": false
        }
      }
    },
    "telemetry": {
      "type": "object",
      "properties": {
        "endpoint": {
          "type": "string",
          "pattern": "^https?://[A-Za-z0-9.:-]+$"
        }
      }
    }
  }
}
