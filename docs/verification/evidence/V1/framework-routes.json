      "path": "/api/docs"
    },
    {
      "method": "HEAD",
      "path": "/api/docs/"
    },
    {
      "method": "GET",
      "path": "/api/docs/static/index.html"
    },
    {
      "method": "HEAD",
      "path": "/api/docs/static/index.html"
    },
    {
      "method": "GET",
      "path": "/api/docs/static/swagger-initializer.js"
    },
    {
      "method": "HEAD",
      "path": "/api/docs/static/swagger-initializer.js"
    },
    {
      "method": "GET",
      "path": "/api/docs/json"
    },
    {
      "method": "HEAD",
      "path": "/api/docs/json"
    },
    {
      "method": "GET",
      "path": "/api/docs/yaml"
    },
    {
      "method": "HEAD",
      "path": "/api/docs/yaml"
    },
    {
      "method": [
        "HEAD",
        "GET"
      ],
      "path": "/api/docs/static/*"
