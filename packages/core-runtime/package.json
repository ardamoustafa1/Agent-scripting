{
  "name": "@verbis/core-runtime",
  "version": "0.0.0",
  "private": true,
  "description": "Shared reactive script renderer, primitives and action interpreter.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "dev": "tsc -b tsconfig.build.json --watch --preserveWatchOutput",
    "lint": "eslint --max-warnings=0 .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --coverage",
    "clean": "rm -rf dist coverage",
    "test:benchmark": "node benchmark/run.mjs",
    "benchmark:serve": "vite preview --config benchmark/vite.config.ts",
    "benchmark:build": "vite build --config benchmark/vite.config.ts"
  },
  "dependencies": {
    "@verbis/script-schema": "workspace:*",
    "@verbis/expr": "workspace:*",
    "@verbis/ui": "workspace:*",
    "@verbis/i18n": "workspace:*",
    "react-i18next": "17.0.15",
    "intl-messageformat": "10.7.18",
    "zod": "^4.1.12",
    "lucide-react": "1.49.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@verbis/config-eslint": "workspace:*",
    "@verbis/config-ts": "workspace:*",
    "@verbis/test-utils": "workspace:*",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^9.39.5",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@testing-library/react": "^16.3.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/user-event": "14.6.7",
    "jsdom": "^27.2.0",
    "@playwright/test": "1.63.0",
    "@axe-core/playwright": "4.13.0",
    "vite": "6.4.3"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
