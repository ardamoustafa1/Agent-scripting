{
  "name": "@verbis/i18n",
  "version": "0.0.0",
  "private": true,
  "description": "i18n catalogs (tr, en) and i18next setup.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "dev": "tsc -b tsconfig.build.json --watch --preserveWatchOutput",
    "lint": "eslint --max-warnings=0 .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --coverage",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "i18next": "^26.4.2",
    "react-i18next": "^17.0.15"
  },
  "peerDependencies": {
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^18.3.27",
    "@verbis/config-eslint": "workspace:*",
    "@verbis/config-ts": "workspace:*",
    "@verbis/test-utils": "workspace:*",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^9.39.5",
    "react": "^18.3.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
