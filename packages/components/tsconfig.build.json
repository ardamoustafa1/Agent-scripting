{
  "extends": "@verbis/config-ts/library-react.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo"
  },
  "include": ["src"],
  "exclude": [
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/test-setup.ts",
    "src/stories/**",
    "src/test-fixtures.tsx"
  ],
  "references": [
    {
      "path": "../core-runtime/tsconfig.build.json"
    },
    {
      "path": "../ui/tsconfig.build.json"
    },
    {
      "path": "../i18n/tsconfig.build.json"
    },
    {
      "path": "../script-schema/tsconfig.build.json"
    },
    {
      "path": "../expr/tsconfig.build.json"
    },
    {
      "path": "../sdk-component/tsconfig.build.json"
    }
  ]
}
