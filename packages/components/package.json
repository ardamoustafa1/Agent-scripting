{
  "name": "@verbis/components",
  "version": "0.0.0",
  "private": true,
  "description": "Screen components built on the core primitives.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./src/styles.css"
  },
  "files": [
    "dist",
    "src/styles.css"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "dev": "tsc -b tsconfig.build.json --watch --preserveWatchOutput",
    "lint": "eslint --max-warnings=0 .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --coverage",
    "clean": "rm -rf dist coverage",
    "storybook": "storybook dev -p 6007 --no-open",
    "storybook:build": "storybook build",
    "test:a11y": "playwright test"
  },
  "dependencies": {
    "@verbis/core-runtime": "workspace:*",
    "@verbis/ui": "workspace:*",
    "@verbis/i18n": "workspace:*",
    "@verbis/script-schema": "workspace:*",
    "@verbis/expr": "workspace:*",
    "zod": "^4.1.12",
    "react-i18next": "17.0.15",
    "@verbis/sdk-component": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@verbis/config-eslint": "workspace:*",
    "@verbis/config-ts": "workspace:*",
    "@verbis/test-utils": "workspace:*",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^9.39.5",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@testing-library/react": "^16.3.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/user-event": "14.6.7",
    "jsdom": "^27.2.0",
    "@playwright/test": "1.63.0",
    "@axe-core/playwright": "4.13.0",
    "vite": "6.4.3",
    "storybook": "8.6.18",
    "@storybook/react-vite": "8.6.18",
    "@storybook/addon-a11y": "8.6.18",
    "@storybook/addon-essentials": "8.6.18",
    "@storybook/addon-themes": "8.6.18",
    "@storybook/react": "8.6.18"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
