{
  "extends": "@verbis/config-ts/library-react.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo"
  },
  "include": ["src"],
  "exclude": [
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/test-setup.ts",
    "src/**/*.stories.tsx",
    "src/stories/**"
  ],
  "references": [
    {
      "path": "../i18n/tsconfig.build.json"
    },
    {
      "path": "../shared-types/tsconfig.build.json"
    }
  ]
}
